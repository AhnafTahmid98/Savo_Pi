[Unit]
Description=Robot SAVO role-selected safe bringup
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=@SAVO_USER@
Group=@SAVO_GROUP@
WorkingDirectory=@SAVO_ROOT@
EnvironmentFile=/etc/robot-savo/robot-savo.env
EnvironmentFile=/etc/robot-savo/robot-savo.paths.env
Environment=SAVO_ROBOT_MODE=safe_idle
Environment=SAVO_BRINGUP_PROFILE=lidar_only
Environment=SAVO_CONTROL_STARTUP_MODE=STOP
Environment=SAVO_SERVICE_UNIT=savo.service
RuntimeDirectory=robot-savo
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
ExecStart=@SAVO_ROOT@/deploy/common/run_role.sh
Restart=on-failure
RestartPreventExitStatus=4
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30
KillMode=control-group
UMask=0027
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
