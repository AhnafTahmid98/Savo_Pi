[Unit]
Description=Robot SAVO explicitly enabled manual mapping
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/robot-savo/enable-mapping-service

[Service]
Type=simple
User=@SAVO_USER@
Group=@SAVO_GROUP@
WorkingDirectory=@SAVO_ROOT@
EnvironmentFile=-/etc/robot-savo/robot-savo.env
EnvironmentFile=/etc/robot-savo/robot-savo.paths.env
Environment=SAVO_CONTROL_STARTUP_MODE=STOP
Environment=SAVO_SERVICE_UNIT=savo_mapping.service
RuntimeDirectory=robot-savo
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
ExecCondition=/usr/bin/python3 @SAVO_ROOT@/deploy/common/runtime_ownership.py preflight --owner mapping --allow-unit savo_mapping.service
ExecStart=@SAVO_ROOT@/deploy/core/run_mapping_service.sh
Restart=on-failure
RestartPreventExitStatus=4
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30
KillMode=control-group
UMask=0027
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
