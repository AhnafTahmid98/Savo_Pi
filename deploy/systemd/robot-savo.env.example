SAVO_ROLE=core
SAVO_ROOT=/opt/robot-savo
SAVO_WS=/opt/robot-savo/savo_ws
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
SAVO_ROBOT_MODE=safe_idle
SAVO_BRINGUP_PROFILE=lidar_only
SAVO_CONTROL_STARTUP_MODE=STOP
SAVO_START_UI=false

# SavoMind physical speech Unix-socket contract.
SAVOMIND_SPEECH_SOCKET_PATH=/run/savomind/speech.sock
SAVO_SPEECH_CLIENT_UID=1000
