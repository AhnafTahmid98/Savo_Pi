[Unit]
Description=Robot Savo Typed Location Integration Stack (%i)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5
ConditionPathExists=/home/%i/Savo_Pi/deploy/core/run_location_stack.sh
ConditionPathExists=/home/%i/Savo_Pi/savo_ws/install/setup.bash

[Service]
Type=simple
User=%i
Group=%i
WorkingDirectory=/home/%i/Savo_Pi

Environment=SAVO_ROOT=/home/%i/Savo_Pi
Environment=ROS_DISTRO=jazzy
Environment=PYTHONUNBUFFERED=1
Environment=RCUTILS_LOGGING_BUFFERED_STREAM=1

StateDirectory=robot_savo
StateDirectoryMode=0750
LogsDirectory=robot_savo
LogsDirectoryMode=0750
RuntimeDirectory=robot_savo
RuntimeDirectoryMode=0750

ExecStart=/home/%i/Savo_Pi/deploy/core/run_location_stack.sh

Restart=on-failure
RestartSec=5
TimeoutStartSec=45
TimeoutStopSec=30
KillSignal=SIGINT
KillMode=control-group
SendSIGKILL=yes
UMask=0027

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/robot_savo
ReadWritePaths=/var/log/robot_savo
ReadWritePaths=/run/robot_savo

[Install]
WantedBy=multi-user.target
