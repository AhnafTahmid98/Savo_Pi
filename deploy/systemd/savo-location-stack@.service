[Unit]
Description=Robot Savo Typed Location Integration Stack (%i)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5
ConditionPathExists=@SAVO_ROOT@/deploy/core/run_location_stack.sh
ConditionPathExists=@SAVO_WS@/install/setup.bash

[Service]
Type=simple
User=@SAVO_USER@
Group=@SAVO_GROUP@
WorkingDirectory=@SAVO_ROOT@

EnvironmentFile=-/etc/robot-savo/robot-savo.env
EnvironmentFile=/etc/robot-savo/robot-savo.paths.env
Environment=ROS_DISTRO=jazzy
Environment=PYTHONUNBUFFERED=1
Environment=RCUTILS_LOGGING_BUFFERED_STREAM=1
Environment=SAVO_SERVICE_UNIT=savo-location-stack@%i.service

StateDirectory=robot_savo
StateDirectoryMode=0750
LogsDirectory=robot_savo
LogsDirectoryMode=0750
RuntimeDirectory=robot_savo
RuntimeDirectoryMode=0750

ExecCondition=/usr/bin/python3 @SAVO_ROOT@/deploy/common/runtime_ownership.py preflight --owner location --allow-unit savo-location-stack@%i.service
ExecStart=@SAVO_ROOT@/deploy/core/run_location_stack.sh

Restart=on-failure
RestartPreventExitStatus=4
RestartSec=5
TimeoutStartSec=45
TimeoutStopSec=30
KillSignal=SIGINT
KillMode=control-group
SendSIGKILL=yes
UMask=0027

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/robot_savo
ReadWritePaths=/var/log/robot_savo
ReadWritePaths=/run/robot_savo

[Install]
WantedBy=multi-user.target
