[Unit]
Description=Robot Savo global supervisor and startup authority
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5
ConditionPathExists=@WORKSPACE@/install/setup.bash
ConditionPathExists=@WORKSPACE@/install/savo_supervisor/lib/savo_supervisor/run_supervisor.sh

[Service]
Type=simple
User=@ROBOT_USER@
Group=@ROBOT_USER@
WorkingDirectory=@ROBOT_HOME@/Savo_Pi

Environment=ROS_DISTRO=jazzy
Environment=SAVO_WORKSPACE=@WORKSPACE@
Environment=SAVO_SUPERVISOR_STATE_PATH=/var/lib/robot_savo/supervisor/system_state.json
Environment=SAVO_SUPERVISOR_AUTO_ARM=false
Environment=ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET
Environment=RCUTILS_LOGGING_BUFFERED_STREAM=1

StateDirectory=robot_savo
StateDirectoryMode=0750
LogsDirectory=robot_savo
LogsDirectoryMode=0750
RuntimeDirectory=savo_supervisor
RuntimeDirectoryMode=0750

ExecStart=@WORKSPACE@/install/savo_supervisor/lib/savo_supervisor/run_supervisor.sh
Restart=on-failure
RestartSec=3
TimeoutStartSec=45
TimeoutStopSec=20
KillSignal=SIGINT
KillMode=control-group
SendSIGKILL=yes
UMask=0027

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/robot_savo
ReadWritePaths=/var/log/robot_savo
ReadWritePaths=/run/savo_supervisor

[Install]
WantedBy=multi-user.target
