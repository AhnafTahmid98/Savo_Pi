# Robot Savo — mapping-owned supervisor-authorized location review gateway.
#
# The gateway resolves the authoritative candidate from savo_locations,
# requests authorization from savo_supervisor, then forwards exactly one
# approval or rejection mutation to the registry.

uint8 DECISION_APPROVE=1
uint8 DECISION_REJECT=2

string request_id
string actor_id
uint8 decision
string candidate_id
uint64 expected_candidate_revision

# Optional approval overrides. Empty values preserve the candidate suggestion.
string location_id
string display_name
string[] aliases
string semantic_type
geometry_msgs/PoseStamped approach_pose
bool confirmation_pose_valid
geometry_msgs/PoseStamped confirmation_pose
bool arrival_confirmation_required
string building
string floor
string area
string notes

# Required only when decision is DECISION_REJECT.
string rejection_reason
---
uint8 RESULT_APPROVED=0
uint8 RESULT_REJECTED=1
uint8 RESULT_INVALID_REQUEST=2
uint8 RESULT_BUSY=3
uint8 RESULT_CANDIDATE_NOT_FOUND=4
uint8 RESULT_CANDIDATE_NOT_PENDING=5
uint8 RESULT_STALE_REVISION=6
uint8 RESULT_SUPERVISOR_DENIED=7
uint8 RESULT_SUPERVISOR_UNAVAILABLE=8
uint8 RESULT_REGISTRY_UNAVAILABLE=9
uint8 RESULT_REGISTRY_REJECTED=10
uint8 RESULT_TIMED_OUT=11
uint8 RESULT_INTERNAL_ERROR=12

# True only after the registry commits an approval or rejection.
bool completed
bool approved
bool rejected
uint8 result_code
string reason
savo_msgs/LocationCandidate candidate
savo_msgs/LocationRecord location
builtin_interfaces/Time completed_at
