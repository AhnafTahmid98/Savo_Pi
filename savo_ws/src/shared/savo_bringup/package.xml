<?xml version="1.0"?>
<package format="3">
  <name>savo_bringup</name>
  <version>0.5.0</version>
  <description>Production launch and lifecycle integration for Robot Savo.</description>

  <maintainer email="tahmidahnaf998@gmail.com">Ahnaf Tahmid</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>action_msgs</exec_depend>
