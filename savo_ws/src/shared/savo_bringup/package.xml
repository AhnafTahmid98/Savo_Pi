<?xml version="1.0"?>
<package format="3">
  <name>savo_bringup</name>
  <version>0.6.0</version>
  <description>
    Production C++ readiness authority and Python ROS 2 launch orchestration
    for the distributed Robot Savo core and edge stacks.
  </description>

  <maintainer email="tahmidahnaf998@gmail.com">Ahnaf Tahmid</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>diagnostic_msgs</depend>
  <depend>rclcpp</depend>
  <exec_depend>rclpy</exec_depend>
  <depend>std_msgs</depend>

  <exec_depend>action_msgs</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>launch_xml</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <exec_depend>savo_base</exec_depend>
  <exec_depend>savo_bridge</exec_depend>
  <exec_depend>savo_control</exec_depend>
  <exec_depend>savo_description</exec_depend>
  <exec_depend>savo_head</exec_depend>
  <exec_depend>savo_lidar</exec_depend>
  <exec_depend>savo_localization</exec_depend>
  <exec_depend>savo_locations</exec_depend>
  <exec_depend>savo_mapping</exec_depend>
  <exec_depend>savo_msgs</exec_depend>
  <exec_depend>savo_nav</exec_depend>
  <exec_depend>savo_perception</exec_depend>
  <exec_depend>savo_power</exec_depend>
  <exec_depend>savo_realsense</exec_depend>
  <exec_depend>savo_speech</exec_depend>
  <exec_depend>savo_supervisor</exec_depend>
  <exec_depend>savo_ui</exec_depend>
  <exec_depend>savo_vo</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
