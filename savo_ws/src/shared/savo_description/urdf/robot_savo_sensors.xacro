<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="robot_savo_sensors"
    params="
      parent:=base_link
      lidar_xyz:='0 0 0.205' lidar_rpy:='0 0 0'
      imu_xyz:='0 0 0.075' imu_rpy:='0 0 0'
      camera_xyz:='0.135 0 0.155' camera_rpy:='0 0 0'
      tof_left_xyz:='0.125 0.090 0.070' tof_left_rpy:='0 0 0'
      tof_right_xyz:='0.125 -0.090 0.070' tof_right_rpy:='0 0 0'
      ultrasonic_xyz:='0.150 0 0.070' ultrasonic_rpy:='0 0 0'
      display_xyz:='0.115 0 0.145' display_rpy:='0 0 0'
      respeaker_xyz:='0 0 0.180' respeaker_rpy:='0 0 0'
      pantilt_mount_xyz:='0 0 0' pantilt_mount_rpy:='0 0 0'
    ">

    <xacro:sensor_cylinder
      name="laser_frame"
      parent="${parent}"
      xyz="${lidar_xyz}"
      rpy="${lidar_rpy}"
      radius="0.038"
      length="0.040"
      mass="0.18"
      material="savo_lidar"
      axis="z"
    />

    <xacro:sensor_box
      name="imu_link"
      parent="${parent}"
      xyz="${imu_xyz}"
      rpy="${imu_rpy}"
      size_xyz="0.028 0.020 0.006"
      mass="0.01"
      material="savo_pcb"
    />

    <xacro:depth_camera
      name="camera"
      parent="${parent}"
      xyz="${camera_xyz}"
      rpy="${camera_rpy}"
      size_xyz="0.090 0.025 0.025"
      mass="0.075"
      material="savo_camera"
    />

    <xacro:sensor_box
      name="tof_left_link"
      parent="${parent}"
      xyz="${tof_left_xyz}"
      rpy="${tof_left_rpy}"
      size_xyz="0.018 0.012 0.006"
      mass="0.005"
      material="savo_pcb"
    />

    <xacro:sensor_box
      name="tof_right_link"
      parent="${parent}"
      xyz="${tof_right_xyz}"
      rpy="${tof_right_rpy}"
      size_xyz="0.018 0.012 0.006"
      mass="0.005"
      material="savo_pcb"
    />

    <xacro:sensor_box
      name="ultrasonic_front_link"
      parent="${parent}"
      xyz="${ultrasonic_xyz}"
      rpy="${ultrasonic_rpy}"
      size_xyz="0.045 0.018 0.018"
      mass="0.015"
      material="savo_blue"
    />

    <xacro:sensor_box
      name="display_link"
      parent="${parent}"
      xyz="${display_xyz}"
      rpy="${display_rpy}"
      size_xyz="0.165 0.010 0.100"
      mass="0.18"
      material="savo_display"
    />

    <xacro:sensor_cylinder
      name="respeaker_link"
      parent="${parent}"
      xyz="${respeaker_xyz}"
      rpy="${respeaker_rpy}"
      radius="0.033"
      length="0.008"
      mass="0.025"
      material="savo_pcb"
      axis="z"
    />

    <xacro:sensor_frame
      name="pantilt_mount_link"
      parent="${parent}"
      xyz="${pantilt_mount_xyz}"
      rpy="${pantilt_mount_rpy}"
    />

  </xacro:macro>

</robot>
