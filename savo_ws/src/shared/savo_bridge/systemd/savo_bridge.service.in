[Unit]
Description=Robot Savo native ROS bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@ROBOT_USER@
Group=savomind-bridge
SupplementaryGroups=savomind-bridge
RuntimeDirectory=savo_bridge
RuntimeDirectoryMode=0770
UMask=0007
Environment=ROS_DISTRO=jazzy
Environment=SAVO_WORKSPACE=@WORKSPACE@
Environment=SAVO_BRIDGE_CONFIG=@WORKSPACE@/install/savo_bridge/share/savo_bridge/config/savo_bridge.edge.yaml
Environment=SAVO_ACTIVE_MAP_ID=saved_map
Environment=SAVO_ACTIVE_MAP_REVISION=1
ExecStart=@WORKSPACE@/install/savo_bridge/lib/savo_bridge/run_edge_bridge.sh
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/run/savo_bridge

[Install]
WantedBy=multi-user.target
