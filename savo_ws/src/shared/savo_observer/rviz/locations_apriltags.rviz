Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/RobotModel
      Description Source: Topic
      Description Topic: {Depth: 1, Durability Policy: Transient Local, History Policy: Keep Last, Reliability Policy: Reliable, Value: /robot_description}
      Enabled: true
      Name: RobotModel
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TFAndAprilTagFrames
      Show Arrows: true
      Show Axes: true
      Show Names: true
    - Class: rviz_default_plugins/Map
      Enabled: true
      Name: Map
      Topic: {Depth: 1, Durability Policy: Transient Local, History Policy: Keep Last, Reliability Policy: Reliable, Value: /map}
  Enabled: true
  Global Options: {Background Color: "30; 34; 40", Fixed Frame: map, Frame Rate: 15}
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Transformation: {Current: {Class: rviz_default_plugins/TF}}
  Value: true
  Views: {Current: {Class: rviz_default_plugins/Orbit, Distance: 4.0, Name: Current View, Target Frame: base_footprint}, Saved: ~}
Window Geometry: {Height: 900, Width: 1400, X: 80, Y: 60}
