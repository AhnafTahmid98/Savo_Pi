Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/RobotModel
      Description Source: Topic
      Description Topic: {Depth: 1, Durability Policy: Transient Local, History Policy: Keep Last, Reliability Policy: Reliable, Value: /robot_description}
      Enabled: true
      Name: RobotModel
    - Class: rviz_default_plugins/Map
      Enabled: true
      Name: Map
      Topic: {Depth: 1, Durability Policy: Transient Local, History Policy: Keep Last, Reliability Policy: Reliable, Value: /map}
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 0.10
      Name: TF
      Show Arrows: false
      Show Axes: false
      Show Names: false
      Update Interval: 0
      Value: true
    - Class: rviz_default_plugins/Odometry
      Covariance:
        Orientation: {Value: false}
        Position: {Value: false}
        Value: false
      Enabled: true
      Keep: 1
      Name: FilteredOdometry
      Shape: {Alpha: 0.9, Axes Length: 0.20, Axes Radius: 0.015, Color: "30; 230; 70", Value: Arrow}
      Topic: {Depth: 5, Durability Policy: Volatile, History Policy: Keep Last, Reliability Policy: Reliable, Value: /odometry/filtered}
    - Class: rviz_default_plugins/Odometry
      Covariance:
        Orientation: {Value: false}
        Position: {Value: false}
        Value: false
      Enabled: true
      Keep: 1
      Name: WheelOdometry
      Shape: {Alpha: 0.65, Axes Length: 0.16, Axes Radius: 0.01, Color: "40; 130; 255", Value: Arrow}
      Topic: {Depth: 5, Durability Policy: Volatile, History Policy: Keep Last, Reliability Policy: Reliable, Value: /wheel/odom}
    - Class: rviz_default_plugins/Odometry
      Covariance:
        Orientation: {Value: false}
        Position: {Value: false}
        Value: false
      Enabled: false
      Keep: 1
      Name: VisualOdometry
      Shape: {Alpha: 0.65, Axes Length: 0.16, Axes Radius: 0.01, Color: "255; 75; 215", Value: Arrow}
      Topic: {Depth: 5, Durability Policy: Volatile, History Policy: Keep Last, Reliability Policy: Best Effort, Value: /vo/odom}
      Value: false
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: LocalizationMarkers
      Topic: {Depth: 5, Durability Policy: Volatile, History Policy: Keep Last, Reliability Policy: Reliable, Value: /savo_observer/localization_markers}
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Enabled: true
      Name: LiDAR
      Topic: {Depth: 5, Durability Policy: Volatile, History Policy: Keep Last, Reliability Policy: Best Effort, Value: /scan}
  Enabled: true
  Global Options: {Background Color: "30; 34; 40", Fixed Frame: map, Frame Rate: 20}
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Transformation: {Current: {Class: rviz_default_plugins/TF}}
  Value: true
  Views: {Current: {Class: rviz_default_plugins/Orbit, Distance: 4.0, Name: Current View, Target Frame: base_footprint}, Saved: ~}
Window Geometry: {Height: 900, Width: 1400, X: 80, Y: 60}
