from pathlib import Path
import re
import shutil
import subprocess
import textwrap
import xml.etree.ElementTree as ET

import pytest
import yaml


ROOT = Path(__file__).resolve().parents[2]
INCLUDE_DIR = ROOT / 'include'
CONFIG_DIR = ROOT / 'config'


def load_yaml(filename):
    path = CONFIG_DIR / filename

    with path.open('r', encoding='utf-8') as stream:
        value = yaml.safe_load(stream)

    assert isinstance(value, dict)
    return value


def read_string_constants(filename):
    path = INCLUDE_DIR / 'savo_nav' / filename
    text = path.read_text(encoding='utf-8')

    pattern = re.compile(
        'inline\\s+constexpr\\s+std::string_view\\s+'
        '(k[A-Za-z0-9]+)\\s*=\\s*'
        '\\"([^\\"]+)\\";',
        re.MULTILINE,
    )

    return dict(pattern.findall(text))


def test_package_identity():
    package = ET.parse(ROOT / 'package.xml').getroot()
    constants = read_string_constants('constants.hpp')

    assert package.attrib['format'] == '3'
    assert package.findtext('name') == 'savo_nav'
    assert package.findtext('version') == '0.1.0'
    assert package.findtext('license') == 'Proprietary'

    assert constants['kPackageName'] == 'savo_nav'
    assert constants['kRobotName'] == 'Robot Savo'
    assert constants['kRosDistro'] == 'jazzy'
    assert constants['kVersion'] == '0.1.0'


