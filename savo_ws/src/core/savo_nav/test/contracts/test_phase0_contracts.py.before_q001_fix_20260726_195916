def test_velocity_boundary():
    contract = load_yaml('topics.yaml')

    nav_output = contract['topics']['velocity_output']['navigation']
    forbidden = contract['topics']['forbidden_velocity_outputs']

    assert nav_output == '/cmd_vel_nav'

    assert forbidden == [
        '/cmd_vel',
        '/cmd_vel_safe',
        '/cmd_vel_recovery',
    ]

    assert nav_output not in forbidden

    assert contract['constraints'][
        'only_navigation_velocity_output'
    ] == '/cmd_vel_nav'


def test_action_header_matches_yaml():
    contract = load_yaml('action_servers.yaml')
    constants = read_string_constants('action_names.hpp')

    public_actions = contract['actions']['public']
    internal_actions = contract['actions']['internal']

    assert constants['kNavigationNavigateToPose'] == (
        public_actions['navigation_navigate_to_pose']['name']
    )

    assert constants['kExplorationNavigateToPose'] == (
        public_actions['exploration_navigate_to_pose']['name']
    )

    assert constants['kNav2NavigateToPose'] == (
        internal_actions['nav2_navigate_to_pose']['name']
    )

    assert contract['constraints']['maximum_active_nav2_goals'] == 1

    assert not contract['constraints'][
        'silent_goal_replacement_allowed'
    ]

    assert contract['constraints'][
        'cancellation_acknowledgement_required'
    ]


def test_frame_header_matches_yaml():
    contract = load_yaml('frames.yaml')
    constants = read_string_constants('frame_names.hpp')

    assert constants['kMap'] == contract['frames']['map']
    assert constants['kOdom'] == contract['frames']['odom']

    assert constants['kBaseFootprint'] == (
        contract['frames']['robot_base']
    )

    assert constants['kBaseLink'] == (
        contract['frames']['robot_body']
    )

    assert constants['kLaser'] == contract['frames']['lidar']

    assert constants['kCameraDepthOptical'] == (
        contract['frames']['realsense_depth_optical']
    )

    chain = [
        (item['parent'], item['child'])
        for item in contract['tf_chain']
    ]

    assert chain == [
        ('map', 'odom'),
        ('odom', 'base_footprint'),
        ('base_footprint', 'base_link'),
    ]

    assert contract['constraints'][
        'nav2_robot_base_frame'
    ] == 'base_footprint'


def test_mapping_action_compatibility():
    mapping_header = (
        ROOT.parent
        / 'savo_mapping'
        / 'include'
        / 'savo_mapping'
        / 'exploration_goal_handoff.hpp'
    )

    if not mapping_header.is_file():
        pytest.skip('savo_mapping header is unavailable')

    mapping_text = mapping_header.read_text(encoding='utf-8')

    assert (
        '"/savo_nav/exploration/navigate_to_pose"'
        in mapping_text
    )


def test_control_accepts_navigation_velocity():
    control_config = (
        ROOT.parent
        / 'savo_control'
        / 'config'
        / 'twist_mux.yaml'
    )

    if not control_config.is_file():
        pytest.skip('savo_control twist_mux is unavailable')

