    assert '/cmd_vel_nav' in control_text


def test_no_service_contract_is_invented():
    service_header = (
        INCLUDE_DIR / 'savo_nav' / 'service_names.hpp'
    ).read_text(encoding='utf-8')

    assert 'std::string_view' not in service_header

    assert re.search(
        r'"/[A-Za-z0-9_/]+"',
        service_header,
    ) is None


def test_contract_identity():
    for filename in (
        'topics.yaml',
        'action_servers.yaml',
        'frames.yaml',
    ):
        contract = load_yaml(filename)

        assert contract['contract_version'] == 1
        assert contract['package'] == 'savo_nav'


