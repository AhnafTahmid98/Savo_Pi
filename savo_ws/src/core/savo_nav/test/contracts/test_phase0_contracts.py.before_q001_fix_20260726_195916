def test_contract_headers_compile(tmp_path):
    compiler = shutil.which('c++')

    if compiler is None:
        pytest.skip('No C++ compiler is installed')

    source = tmp_path / 'contract_compile.cpp'
    object_file = tmp_path / 'contract_compile.o'

    source.write_text(
        textwrap.dedent(
            '''
            #include "savo_nav/action_names.hpp"
            #include "savo_nav/constants.hpp"
            #include "savo_nav/frame_names.hpp"
            #include "savo_nav/service_names.hpp"
            #include "savo_nav/topic_names.hpp"

            static_assert(
              savo_nav::constants::kVersionMajor == 0);

            static_assert(
              savo_nav::constants::kVersionMinor == 1);

            static_assert(
              savo_nav::constants::kVersionPatch == 0);

            static_assert(
              savo_nav::constants::kContractVersion == 1);

            static_assert(
              savo_nav::topics::kNavigationVelocity ==
              "/cmd_vel_nav");

            static_assert(
              savo_nav::actions::kExplorationNavigateToPose ==
              "/savo_nav/exploration/navigate_to_pose");

            static_assert(
              savo_nav::frames::kBaseFootprint ==
              "base_footprint");

            int main()
            {
              return 0;
            }
            '''
        ).lstrip(),
        encoding='utf-8',
    )

    result = subprocess.run(
        [
            compiler,
            '-std=c++17',
            '-Wall',
            '-Wextra',
            '-Wpedantic',
            '-I',
            str(INCLUDE_DIR),
            '-c',
            str(source),
            '-o',
            str(object_file),
        ],
        check=False,
        capture_output=True,
        text=True,
    )

    assert result.returncode == 0, (
        result.stdout + result.stderr
    )

    assert object_file.is_file()
