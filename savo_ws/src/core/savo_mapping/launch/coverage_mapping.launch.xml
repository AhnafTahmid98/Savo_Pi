<?xml version="1.0" encoding="UTF-8"?>

<launch>

  <arg
    name="params_file"
    default="$(find-pkg-share savo_mapping)/config/coverage_mapping.yaml"
    description="Base Coverage mapper parameters"/>

  <arg
    name="profile_file"
    default="$(find-pkg-share savo_mapping)/config/profiles/coverage_mapping_real_robot.yaml"
    description="Optional guarded real-robot parameter overlay"/>

  <arg
    name="use_real_robot_profile"
    default="false"
    description="Load conservative real-robot planning overrides"/>

  <arg name="enabled" default="true" description="Enable the Coverage planning node"/>
  <arg name="auto_plan" default="false" description="Explicitly request planning when map and TF are ready"/>
  <arg name="plan_once" default="true" description="Publish at most one successful plan per activation"/>
  <arg name="replan_on_map_update" default="false" description="Permit bounded replanning after a changed valid map"/>

  <arg name="map_topic" default="/map" description="Occupancy map input"/>
  <arg name="map_frame" default="map" description="Required map frame"/>
  <arg name="base_frame" default="base_link" description="Robot frame resolved through TF"/>
  <arg name="path_topic" default="/savo_mapping/coverage/path" description="Read-only planned Coverage path"/>
  <arg name="status_topic" default="/savo_mapping/coverage/status" description="Coverage status output"/>
  <arg name="state_topic" default="/savo_mapping/coverage/state" description="Coverage state output"/>

  <arg name="use_sim_time" default="false" description="Use the ROS simulation clock"/>

  <node
    pkg="savo_mapping"
    exec="coverage_mapper_node"
    name="coverage_mapper_node"
    output="screen"
    unless="$(var use_real_robot_profile)">

    <param from="$(var params_file)"/>
    <param name="enabled" value="$(var enabled)"/>
    <param name="auto_plan" value="$(var auto_plan)"/>
    <param name="plan_once" value="$(var plan_once)"/>
    <param name="replan_on_map_update" value="$(var replan_on_map_update)"/>
    <param name="map_topic" value="$(var map_topic)"/>
    <param name="map_frame" value="$(var map_frame)"/>
    <param name="base_frame" value="$(var base_frame)"/>
    <param name="path_topic" value="$(var path_topic)"/>
    <param name="status_topic" value="$(var status_topic)"/>
    <param name="state_topic" value="$(var state_topic)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>

  <node
    pkg="savo_mapping"
    exec="coverage_mapper_node"
    name="coverage_mapper_node"
    output="screen"
    if="$(var use_real_robot_profile)">

    <param from="$(var params_file)"/>
    <param from="$(var profile_file)"/>
    <param name="enabled" value="$(var enabled)"/>
    <param name="auto_plan" value="$(var auto_plan)"/>
    <param name="plan_once" value="$(var plan_once)"/>
    <param name="replan_on_map_update" value="$(var replan_on_map_update)"/>
    <param name="map_topic" value="$(var map_topic)"/>
    <param name="map_frame" value="$(var map_frame)"/>
    <param name="base_frame" value="$(var base_frame)"/>
    <param name="path_topic" value="$(var path_topic)"/>
    <param name="status_topic" value="$(var status_topic)"/>
    <param name="state_topic" value="$(var state_topic)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>

</launch>
