<?xml version="1.0" encoding="UTF-8"?>

<launch>
  <arg
    name="start_mapping_stack"
    default="true"
    description="Start the manual SLAM mapping stack before semantic nodes"/>

  <arg
    name="map_id"
    default=""
    description="Stable lowercase map identifier"/>

  <arg
    name="map_output_root"
    default="~/Savo_Pi/runtime/maps"
    description="Root directory for map sessions"/>

  <arg name="allow_map_overwrite" default="false"/>
  <arg name="use_sim_time" default="false"/>
  <arg name="autostart" default="true"/>

  <arg
    name="slam_params_file"
    default="$(find-pkg-share savo_mapping)/config/slam_toolbox_mapping.yaml"/>

  <include
    if="$(var start_mapping_stack)"
    file="$(find-pkg-share savo_mapping)/launch/manual_mapping.launch.xml">
    <arg name="map_id" value="$(var map_id)"/>
    <arg name="map_output_root" value="$(var map_output_root)"/>
    <arg name="allow_map_overwrite" value="$(var allow_map_overwrite)"/>
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
    <arg name="autostart" value="$(var autostart)"/>
    <arg name="slam_params_file" value="$(var slam_params_file)"/>
    <arg name="semantic_mapping_enabled" value="true"/>
  </include>

  <node
    pkg="savo_mapping"
    exec="mapped_location_registration_node"
    name="mapped_location_registration_node"
    output="screen">
    <param
      from="$(find-pkg-share savo_mapping)/config/semantic_landmarks.yaml"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>

  <node
    pkg="savo_mapping"
    exec="location_review_gateway_node"
    name="location_review_gateway_node"
    output="screen">
    <param
      from="$(find-pkg-share savo_mapping)/config/semantic_landmarks.yaml"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>

  <node
    pkg="savo_mapping"
    exec="semantic_landmark_bridge_node"
    name="semantic_landmark_bridge_node"
    output="screen">
    <param
      from="$(find-pkg-share savo_mapping)/config/semantic_landmarks.yaml"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>
</launch>
