<?xml version="1.0" encoding="UTF-8"?>

<launch>

  <arg
    name="map_id"
    default=""
    description="Stable lowercase map identifier shared by the mission and save session"/>

  <arg
    name="map_output_root"
    default="~/Savo_Pi/runtime/maps"
    description="Root directory for committed autonomous map sessions"/>

  <arg
    name="allow_map_overwrite"
    default="false"
    description="Allow replacement of an existing committed map session"/>

  <arg
    name="use_sim_time"
    default="false"/>

  <arg
    name="slam_autostart"
    default="true"
    description="Configure and activate SLAM Toolbox automatically"/>

  <arg
    name="slam_params_file"
    default="$(find-pkg-share savo_mapping)/config/slam_toolbox_mapping.yaml"
    description="SLAM Toolbox online mapping parameters"/>

  <arg
    name="mapping_profile_file"
    default="$(find-pkg-share savo_mapping)/config/profiles/monitor_only.yaml"
    description="Read-only mapping-supervisor readiness profile"/>

  <arg
    name="frontier_params_file"
    default="$(find-pkg-share savo_mapping)/config/frontier_mapping.yaml"/>

  <arg
    name="handoff_params_file"
    default="$(find-pkg-share savo_mapping)/config/exploration_goal_handoff.yaml"/>

  <arg
    name="exploration_manager_params_file"
    default="$(find-pkg-share savo_mapping)/config/exploration_manager.yaml"/>

  <arg
    name="orchestrator_params_file"
    default="$(find-pkg-share savo_mapping)/config/autonomous_mapping_orchestrator.yaml"/>

  <arg name="coverage_enabled" default="true"/>
  <arg
    name="coverage_params_file"
    default="$(find-pkg-share savo_mapping)/config/coverage_mapping.yaml"/>
  <arg
    name="coverage_profile_file"
    default="$(find-pkg-share savo_mapping)/config/profiles/coverage_mapping_real_robot.yaml"/>
  <arg name="coverage_use_real_robot_profile" default="true"/>
  <arg
    name="coverage_execution_handoff_params_file"
    default="$(find-pkg-share savo_mapping)/config/coverage_execution_handoff.yaml"/>
  <arg
    name="coverage_operation_params_file"
    default="$(find-pkg-share savo_mapping)/config/coverage_operation_orchestrator.yaml"/>
  <arg name="final_scan360_required" default="true"/>
  <arg name="final_head_scan_required" default="true"/>
  <arg
    name="geometry_profile"
    default="$(find-pkg-share savo_description)/config/profiles/robot_savo_core_v1.yaml"/>
  <arg name="require_locked_geometry" default="true"/>
  <arg name="allow_provisional_geometry" default="false"/>

  <arg
    name="semantic_interruption_enabled"
    default="true"
    description="Start continuous AprilTag semantic interruption coordination"/>

  <arg
    name="semantic_interruption_params_file"
    default="$(find-pkg-share savo_mapping)/config/semantic_interruption.yaml"/>

  <arg
    name="scan360_params_file"
    default="$(find-pkg-share savo_mapping)/config/scan360_mapping.yaml"/>

  <arg
    name="scan360_profile_file"
    default="$(find-pkg-share savo_mapping)/config/profiles/scan360_real_robot.yaml"/>

  <arg
    name="scan360_use_real_robot_profile"
    default="true"
    description="Load conservative real-robot Scan360 timing overrides"/>

  <arg
    name="map_frame"
    default="map"/>

  <arg
    name="base_frame"
    default="base_link"/>

  <!--
    Start in monitor-only/idle. The typed RunAutonomousMapping action owns the
    transition to an active autonomous frontier session. Launching this file
    never authorizes motion by itself.
  -->
  <node
    pkg="savo_mapping"
    exec="mapping_mode_manager_node"
    name="mapping_mode_manager_node"
    output="screen">

    <param
      from="$(find-pkg-share savo_mapping)/config/mapping_mode_manager.yaml"/>

    <param
      name="authority.initial_mode"
      value="monitor_only"/>

    <param
      name="authority.initial_session_state"
      value="idle"/>

    <param
      name="use_sim_time"
      value="$(var use_sim_time)"/>
  </node>

  <node
    pkg="savo_mapping"
    exec="mapping_supervisor_node"
    name="mapping_supervisor_node"
    output="screen">

    <param
      from="$(find-pkg-share savo_mapping)/config/topics.yaml"/>

    <param
      from="$(find-pkg-share savo_mapping)/config/frames.yaml"/>

    <param
      from="$(find-pkg-share savo_mapping)/config/mapping_common.yaml"/>

    <param
      from="$(find-pkg-share savo_mapping)/config/map_session.yaml"/>

    <param
      from="$(var mapping_profile_file)"/>

    <param
      name="use_sim_time"
      value="$(var use_sim_time)"/>
  </node>

  <include
    file="$(find-pkg-share slam_toolbox)/launch/online_async_launch.py">

    <arg
      name="slam_params_file"
      value="$(var slam_params_file)"/>

    <arg
      name="use_sim_time"
      value="$(var use_sim_time)"/>

    <arg
      name="autostart"
      value="$(var slam_autostart)"/>

    <arg
      name="use_lifecycle_manager"
      value="false"/>
  </include>

  <node
    pkg="savo_mapping"
    exec="slam_lifecycle_health_bridge_node"
    name="slam_lifecycle_health_bridge_node"
    output="screen">

    <param
      from="$(find-pkg-share savo_mapping)/config/slam_lifecycle_health.yaml"/>

    <param
      name="use_sim_time"
      value="$(var use_sim_time)"/>
  </node>

  <include
    file="$(find-pkg-share savo_mapping)/launch/map_session_manager.launch.xml">

    <arg
      name="map_id"
      value="$(var map_id)"/>

    <arg
      name="map_output_root"
      value="$(var map_output_root)"/>

    <arg
      name="allow_map_overwrite"
      value="$(var allow_map_overwrite)"/>

    <arg
      name="use_sim_time"
      value="$(var use_sim_time)"/>
  </include>

  <include
    file="$(find-pkg-share savo_mapping)/launch/frontier_mapping.launch.xml">

    <!-- Static node gate is open; exploration_manager runtime authority remains closed. -->
    <arg
      name="enabled"
      value="true"/>

    <arg
      name="use_sim_time"
      value="$(var use_sim_time)"/>

    <arg
      name="map_frame"
      value="$(var map_frame)"/>

    <arg
      name="base_frame"
      value="$(var base_frame)"/>

    <arg
      name="frontier_params_file"
      value="$(var frontier_params_file)"/>

    <arg
      name="handoff_params_file"
      value="$(var handoff_params_file)"/>

    <arg
      name="manager_params_file"
      value="$(var exploration_manager_params_file)"/>
  </include>

  <include
    file="$(find-pkg-share savo_mapping)/launch/scan360_mapping.launch.xml">

    <arg
      name="params_file"
      value="$(var scan360_params_file)"/>

    <arg
      name="profile_file"
      value="$(var scan360_profile_file)"/>

    <arg
      name="use_real_robot_profile"
      value="$(var scan360_use_real_robot_profile)"/>

    <arg
      name="enabled"
      value="true"/>

    <arg
      name="auto_start"
      value="false"/>

    <arg
      name="use_sim_time"
      value="$(var use_sim_time)"/>
  </include>

  <include
    file="$(find-pkg-share savo_mapping)/launch/autonomous_mapping_orchestrator.launch.xml">

    <arg
      name="use_sim_time"
      value="$(var use_sim_time)"/>

    <arg
      name="params_file"
      value="$(var orchestrator_params_file)"/>
    <arg name="coverage_enabled" value="$(var coverage_enabled)"/>
    <arg name="geometry_profile" value="$(var geometry_profile)"/>
    <arg
      name="require_locked_geometry"
      value="$(var require_locked_geometry)"/>
    <arg
      name="allow_provisional_geometry"
      value="$(var allow_provisional_geometry)"/>
    <arg
      name="final_scan360_required"
      value="$(var final_scan360_required)"/>
    <arg
      name="final_head_scan_required"
      value="$(var final_head_scan_required)"/>
  </include>

  <include
    file="$(find-pkg-share savo_mapping)/launch/coverage_mapping.launch.xml"
    if="$(var coverage_enabled)">
    <arg name="params_file" value="$(var coverage_params_file)"/>
    <arg name="profile_file" value="$(var coverage_profile_file)"/>
    <arg
      name="use_real_robot_profile"
      value="$(var coverage_use_real_robot_profile)"/>
    <arg name="enabled" value="true"/>
    <arg name="auto_plan" value="false"/>
    <arg name="start_execution_handoff" value="false"/>
    <arg name="map_frame" value="$(var map_frame)"/>
    <arg name="base_frame" value="$(var base_frame)"/>
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
  </include>

  <include
    file="$(find-pkg-share savo_mapping)/launch/coverage_execution_handoff.launch.xml"
    if="$(var coverage_enabled)">
    <arg
      name="params_file"
      value="$(var coverage_execution_handoff_params_file)"/>
    <arg name="enabled" value="true"/>
    <arg name="expected_frame" value="$(var map_frame)"/>
    <arg
      name="approve_service"
      value="/savo_mapping/_internal/coverage_execution/approve"/>
    <arg
      name="cancel_service"
      value="/savo_mapping/_internal/coverage_execution/cancel"/>
    <arg
      name="reset_service"
      value="/savo_mapping/_internal/coverage_execution/reset"/>
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
  </include>

  <include
    file="$(find-pkg-share savo_mapping)/launch/coverage_operation_orchestrator.launch.xml"
    if="$(var coverage_enabled)">
    <arg name="params_file" value="$(var coverage_operation_params_file)"/>
    <arg name="enabled" value="true"/>
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
  </include>

  <node
    if="$(var semantic_interruption_enabled)"
    pkg="savo_mapping"
    exec="semantic_interruption_coordinator_node"
    name="semantic_interruption_coordinator_node"
    output="screen">

    <param from="$(var semantic_interruption_params_file)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>

</launch>
