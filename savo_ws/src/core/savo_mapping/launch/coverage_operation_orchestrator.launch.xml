<?xml version="1.0" encoding="UTF-8"?>

<launch>

  <arg
    name="params_file"
    default="$(find-pkg-share savo_mapping)/config/coverage_operation_orchestrator.yaml"
    description="Unified Coverage operation orchestration parameters"/>

  <arg name="enabled" default="true" description="Enable Coverage operation orchestration"/>
  <arg name="use_sim_time" default="false" description="Use the ROS simulation clock"/>

  <node
    pkg="savo_mapping"
    exec="coverage_operation_orchestrator_node"
    name="coverage_operation_orchestrator_node"
    output="screen">

    <param from="$(var params_file)"/>
    <param name="enabled" value="$(var enabled)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>

</launch>
