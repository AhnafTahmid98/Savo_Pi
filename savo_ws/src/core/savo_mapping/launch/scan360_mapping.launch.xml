<?xml version="1.0" encoding="UTF-8"?>

<launch>

  <arg
    name="params_file"
    default="$(find-pkg-share savo_mapping)/config/scan360_mapping.yaml"
    description="Base Scan360 mapper parameters"/>

  <arg
    name="profile_file"
    default="$(find-pkg-share savo_mapping)/config/profiles/scan360_real_robot.yaml"
    description="Optional guarded real-robot parameter overlay"/>

  <arg
    name="use_real_robot_profile"
    default="false"
    description="Load conservative real-robot timeout and settling overrides"/>

  <arg
    name="enabled"
    default="true"
    description="Enable the Scan360 mapper state machine"/>

  <arg
    name="auto_start"
    default="false"
    description="Explicitly authorize starting after fresh odometry arrives"/>

  <arg
    name="action_name"
    default="/savo_control/rotate_to_heading"
    description="RotateToHeading action endpoint; fixtures may override it"/>

  <arg
    name="odom_topic"
    default="/odometry/filtered"
    description="Fused odometry input owned by savo_localization"/>

  <arg
    name="odom_frame"
    default="odom"
    description="Required odometry message frame"/>

  <arg
    name="use_sim_time"
    default="false"
    description="Use the ROS simulation clock"/>

  <node
    pkg="savo_mapping"
    exec="scan360_mapper_node"
    name="scan360_mapper_node"
    output="screen"
    unless="$(var use_real_robot_profile)">

    <param from="$(var params_file)"/>

    <param
      name="enabled"
      value="$(var enabled)"/>

    <param
      name="auto_start"
      value="$(var auto_start)"/>

    <param
      name="action_name"
      value="$(var action_name)"/>

    <param
      name="odom_topic"
      value="$(var odom_topic)"/>

    <param
      name="odom_frame"
      value="$(var odom_frame)"/>

    <param
      name="use_sim_time"
      value="$(var use_sim_time)"/>
  </node>

  <node
    pkg="savo_mapping"
    exec="scan360_mapper_node"
    name="scan360_mapper_node"
    output="screen"
    if="$(var use_real_robot_profile)">

    <param from="$(var params_file)"/>

    <param from="$(var profile_file)"/>

    <param
      name="enabled"
      value="$(var enabled)"/>

    <param
      name="auto_start"
      value="$(var auto_start)"/>

    <param
      name="action_name"
      value="$(var action_name)"/>

    <param
      name="odom_topic"
      value="$(var odom_topic)"/>

    <param
      name="odom_frame"
      value="$(var odom_frame)"/>

    <param
      name="use_sim_time"
      value="$(var use_sim_time)"/>
  </node>

</launch>
