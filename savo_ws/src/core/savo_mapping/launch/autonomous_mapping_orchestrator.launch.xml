<?xml version="1.0" encoding="UTF-8"?>

<launch>

  <arg
    name="use_sim_time"
    default="false"/>

  <arg
    name="params_file"
    default="$(find-pkg-share savo_mapping)/config/autonomous_mapping_orchestrator.yaml"/>

  <node
    pkg="savo_mapping"
    exec="autonomous_mapping_orchestrator_node"
    name="autonomous_mapping_orchestrator_node"
    output="screen">

    <param from="$(var params_file)"/>

    <param
      name="use_sim_time"
      value="$(var use_sim_time)"/>
  </node>

</launch>
