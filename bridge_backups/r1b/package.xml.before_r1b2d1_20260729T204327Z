<?xml version="1.0"?>
<?xml-model
  href="http://download.ros.org/schema/package_format3.xsd"
  schematypens="http://www.w3.org/2001/XMLSchema"?>

<package format="3">
  <name>savo_bridge</name>
  <version>0.1.0</version>

  <description>
    Native C++ boundary between the Robot Savo ROS 2 system and
    SavoMind. The bridge will observe verified state from
    savo-core and savo-edge and expose stable runtime data.
  </description>

  <maintainer email="tahmidahnaf998@gmail.com">
    Ahnaf Tahmid
  </maintainer>

  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>diagnostic_msgs</depend>
  <depend>nlohmann-json-dev</depend>
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>

  <test_depend>ament_cmake_cppcheck</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
