+bool frame_is_blank(const std::string & frame)
+{
+  return frame.empty() ||
+         std::all_of(
+    frame.begin(),
+    frame.end(),
+    [](const unsigned char character) {
+      return std::isspace(character) != 0;
+    });
+}
