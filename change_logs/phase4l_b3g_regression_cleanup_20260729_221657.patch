+
+    request->filename =
+      base.generic_string();
+
+    auto future =
+      serialize_map_client_->
+      async_send_request(request);
+
+    if (future.wait_for(timeout) !=
+      std::future_status::ready)
+    {
+      failure_reason =
+        "slam_serialize_map_service_timeout";
