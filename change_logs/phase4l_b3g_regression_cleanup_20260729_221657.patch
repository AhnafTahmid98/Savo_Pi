+
+  output
+    << std::boolalpha
+    << "{"
+    << "\"schema_version\":"
+    << active.schema_version
+    << ",\"active\":"
+    << active.active
+    << ",\"reason\":\""
+    << escape_json(active.reason)
+    << "\",\"release_id\":\""
+    << escape_json(active.release_id)
+    << "\",\"map_id\":\""
+    << escape_json(active.map_id)
+    << "\",\"frame_id\":\""
+    << escape_json(active.frame_id)
+    << "\",\"release_manifest\":\""
