+std::string json_escape(const std::string & input)
+{
+  std::ostringstream output;
+  for (const char character : input) {
+    switch (character) {
+      case '\\':
+        output << "\\\\";
+        break;
+      case '"':
+        output << "\\\"";
+        break;
+      case '\n':
+        output << "\\n";
+        break;
+      case '\r':
+        output << "\\r";
+        break;
+      case '\t':
+        output << "\\t";
+        break;
+      default:
+        output << character;
+        break;
+    }
+  }
+  return output.str();
+}
