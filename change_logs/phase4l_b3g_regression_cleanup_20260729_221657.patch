+  try {
+    rclcpp::spin(
+      std::make_shared<
+        savo_mapping::
+        MappingModeManagerNode>());
+  } catch (
+    const std::exception & exception)
+  {
+    std::cerr
+      << "mapping_mode_manager_node "
+      << "failed: "
+      << exception.what()
+      << '\n';
+
+    rclcpp::shutdown();
+    return 1;
+  }
+
+  rclcpp::shutdown();
+  return 0;
+}
