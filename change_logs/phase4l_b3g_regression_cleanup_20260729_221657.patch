+        std::bind(
+          &FrontierExplorerNode::planning_tick,
+          this));
+
+    set_state(
+      enabled_ ?
+      "waiting_for_runtime_authority" :
+      "disabled",
+      enabled_ ?
+      "waiting_for_runtime_authority" :
+      "exploration_disabled_by_configuration");
+
+    RCLCPP_INFO(
+      get_logger(),
+      "frontier explorer ready: configured_enabled=%s",
+      enabled_ ? "true" : "false");
