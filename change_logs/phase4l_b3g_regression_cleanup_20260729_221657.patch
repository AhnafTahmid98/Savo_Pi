+    << "\",\"release_manifest\":\""
+    << escape_json(
+         release.release_manifest.string())
+    << "\",\"map_yaml\":\""
+    << escape_json(
+         release.map_yaml.string())
+    << "\"}";
+
+  return output.str();
+}
+
+std::string active_map_to_json(
+  const ActiveMapContract & active)
+{
