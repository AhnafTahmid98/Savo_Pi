+}
+
+std::string catalog_to_json(
+  const fs::path & production_root)
+{
+  const fs::path catalog_path =
+    production_root /
+    "catalog.yaml";
+
+  std::ostringstream output;
+
+  output
+    << "{\"schema_version\":1,"
+    << "\"production_root\":\""
+    << escape_json(
+         production_root.string())
+    << "\",\"releases\":[";
+
+  if (fs::is_regular_file(catalog_path)) {
+    const YAML::Node catalog =
+      YAML::LoadFile(
+      catalog_path.string());
+
+    const YAML::Node releases =
+      catalog["releases"];
+
+    bool first = true;
+
+    if (releases &&
+      releases.IsSequence())
+    {
+      for (const auto & entry :
+        releases)
+      {
+        if (!first) {
+          output << ',';
+        }
+
+        first = false;
+
+        output
+          << "{"
+          << "\"release_id\":\""
+          << escape_json(
+               entry["release_id"]
+          .as<std::string>())
+          << "\",\"map_id\":\""
+          << escape_json(
+               entry["map_id"]
+          .as<std::string>())
+          << "\",\"frame_id\":\""
+          << escape_json(
+               entry["frame_id"]
+          .as<std::string>())
+          << "\",\"release_manifest\":\""
+          << escape_json(
+               entry["release_manifest"]
+          .as<std::string>())
+          << "\"}";
+      }
+    }
+  }
+
+  output << "]}";
+
+  return output.str();
+}
