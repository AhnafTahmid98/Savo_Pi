+bool is_known_handoff_state(
+  std::string_view state)
+{
+  return
+    state == "idle" ||
+    state == "waiting_for_savo_nav" ||
+    state == "sending" ||
+    state == "accepted" ||
+    state == "executing" ||
+    state == "canceling" ||
+    state == "succeeded" ||
+    state == "rejected" ||
+    state == "aborted" ||
+    state == "canceled" ||
+    state == "timed_out" ||
+    state == "error";
+}
+
+bool is_active_handoff_state(
+  std::string_view state)
+{
+  return
+    state == "waiting_for_savo_nav" ||
+    state == "sending" ||
+    state == "accepted" ||
+    state == "executing" ||
+    state == "canceling";
+}
+
+std::string json_escape(
+  const std::string & input)
+{
+  std::ostringstream output;
+
+  for (const char character : input) {
+    switch (character) {
+      case '\\':
+        output << "\\\\";
+        break;
+
+      case '"':
+        output << "\\\"";
+        break;
+
+      case '\n':
+        output << "\\n";
+        break;
+
+      case '\r':
+        output << "\\r";
+        break;
+
+      case '\t':
+        output << "\\t";
+        break;
+
+      default:
+        output << character;
+        break;
+    }
+  }
+
+  return output.str();
+}
