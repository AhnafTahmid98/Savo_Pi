+    active_publisher_ =
+      create_publisher<
+      std_msgs::msg::String>(
+        release::kActiveMapTopic,
+        state_qos);
+
+    create_service_ =
+      create_service<
+      std_srvs::srv::Trigger>(
+        release::kCreateReleaseService,
+        std::bind(
+          &MapCatalogManagerNode::
