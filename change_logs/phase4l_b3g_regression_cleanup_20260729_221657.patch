+{
+  switch (status) {
+    case ExplorationPlanningStatus::GoalSelected:
+      return "goal_selected";
+
+    case ExplorationPlanningStatus::NoFrontiers:
+      return "no_frontiers";
+
+    case ExplorationPlanningStatus::NoReachableFrontiers:
+      return "no_reachable_frontiers";
