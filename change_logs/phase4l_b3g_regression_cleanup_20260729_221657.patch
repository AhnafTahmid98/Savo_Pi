+    std_msgs::msg::String>::SharedPtr
+    readiness_subscription_;
+
+  rclcpp::Subscription<
+    std_msgs::msg::String>::SharedPtr
+    handoff_state_subscription_;
+
+  rclcpp::Subscription<
+    std_msgs::msg::Bool>::SharedPtr
+    safety_stop_subscription_;
+};
