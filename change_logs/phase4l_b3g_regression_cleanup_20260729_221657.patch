+int main(int argc, char ** argv)
+{
+  rclcpp::init(argc, argv);
+
+  try {
+    rclcpp::spin(
+      std::make_shared<
+        savo_mapping::FrontierExplorerNode>());
+  } catch (const std::exception & error) {
+    std::cerr
+      << "frontier_explorer_node failed: "
+      << error.what()
+      << '\n';
+
+    rclcpp::shutdown();
+    return 1;
+  }
+
+  rclcpp::shutdown();
+  return 0;
+}
