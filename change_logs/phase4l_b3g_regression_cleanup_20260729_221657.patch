+std::string json_escape(
+  std::string_view input)
+{
+  std::string output;
+  output.reserve(input.size());
+
+  for (const char character : input) {
+    switch (character) {
+      case '\\':
+        output += "\\\\";
+        break;
+
+      case '"':
+        output += "\\\"";
+        break;
+
+      case '\n':
+        output += "\\n";
+        break;
+
+      case '\r':
+        output += "\\r";
+        break;
+
+      case '\t':
+        output += "\\t";
+        break;
+
+      default:
+        output += character;
+        break;
+    }
+  }
+
+  return output;
+}
