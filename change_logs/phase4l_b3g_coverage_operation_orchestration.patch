+
+std::string json_escape(const std::string & value)
+{
+  std::ostringstream output;
+  for (const char character : value) {
+    switch (character) {
+      case '\\':
+        output << "\\\\";
+        break;
+      case '"':
+        output << "\\\"";
+        break;
+      case '\n':
+        output << "\\n";
+        break;
+      case '\r':
+        output << "\\r";
+        break;
+      case '\t':
+        output << "\\t";
+        break;
+      default:
+        output << character;
+        break;
+    }
+  }
+  return output.str();
+}
+
+const char * bool_text(const bool value)
+{
+  return value ? "true" : "false";
+}
